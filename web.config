<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="login.html" />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

    <security>
      <requestFiltering>
        <!-- La app limita los adjuntos a 5 MB; IIS acepta hasta 10 MB para dar margen al multipart/form-data. -->
        <requestLimits maxAllowedContentLength="10485760" />
        <hiddenSegments>
          <!-- Evita acceso HTTP directo a archivos internos. Los require/include de PHP siguen funcionando. -->
          <add segment="base-de-datos" />
          <add segment="config" />
          <add segment="uploads" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <!-- Conserva las respuestas JSON/HTTP generadas por PHP. -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
